<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="sync_log_view_list" model="ir.ui.view">
        <field name="name">sync.log.tree.pos</field>
        <field name="model">sync.log</field>
        <field name="arch" type="xml">
            <!-- Row turns red for both error and cancel states -->
            <list string="Sync Logs"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'error' or status == 'cancel'">
                <field name="created_at"/>
                <field name="endpoint"/>
                <field name="method"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'error' or status == 'cancel'"/>
                <field name="device_id" optional="hide"/>
            </list>
        </field>
    </record>
    <!-- Form View -->
    <record id="sync_log_view_form" model="ir.ui.view">
        <field name="name">sync.log.form.pos</field>
        <field name="model">sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint" readonly="1"/>
                            <field name="method" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_at" readonly="1"/>
                            <field name="device_id" readonly="1" invisible="not device_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload" readonly="1" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response" readonly="1" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="sync_log_action" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu Item in POS Integration -->
    <menuitem id="sync_log_menu"
              name="Sync Logs"
              parent="menu_pos_integration_root"
              action="sync_log_action"
              sequence="30"/>
</odoo>