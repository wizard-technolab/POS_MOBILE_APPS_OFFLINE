# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Symbolication related
app.*.symbols

# Android build/cache
android/.gradle/
android/.kotlin/
android/local.properties
android/**/build/

# Signing / developer identity secrets - keep only encrypted .gpg files in repo
android/key.properties
android/keystore.properties
android/app/key.jks
android/app/*.jks
android/app/*.keystore
*.pem
*.p12
*.mobileprovision
*.cer

# Obfuscation related
app.*.map.json

# Dart define secrets
.env
*.env

# Keep encrypted versions if you commit them intentionally
!*.gpg

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
