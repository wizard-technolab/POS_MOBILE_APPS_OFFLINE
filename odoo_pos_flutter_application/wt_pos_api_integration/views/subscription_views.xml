<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_subscription" model="ir.ui.view">
        <field name="name">res.users.form.subscription</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="subscription" string="Subscription License">
                    <group name="subscription" string="License Information">
                        <group>
                            <field name="subscription_code"
                                   string="License Code"
                                   help="Unique subscription code for this user"/>
                            <field name="subscription_exp_date"
                                   string="Expiration Date"
                                   help="License expiration date"/>
                        </group>
                    </group>

                    <group name="subscription_status" string="Status">
                        <group>
                            <field name="subscription_status"
                                   string="License Status"
                                   readonly="1"
                                   widget="badge"/>
                            <field name="subscription_days_remaining"
                                   string="Days Remaining"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group name="subscription_usage" string="Information">
                        <group>
                            <div colspan="2">
                                <p class="text-muted">
                                    These fields are automatically filled when the user 
                                    activates their subscription via the mobile app.
                                </p>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- List view for subscription licenses -->
    <record id="subscription_license_view_list" model="ir.ui.view">
        <field name="name">subscription.license.list</field>
        <field name="model">subscription.license</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="user_id"/>
                <field name="email"/>
                <field name="expiration_date"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'active'" 
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'revoked'"/>
            </list>
        </field>
    </record>

    <!-- Form view for subscription licenses -->
    <record id="subscription_license_view_form" model="ir.ui.view">
        <field name="name">subscription.license.form</field>
        <field name="model">subscription.license</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="expiration_date"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="email" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="status" readonly="1" widget="badge"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for subscription licenses -->
    <record id="subscription_license_action" model="ir.actions.act_window">
        <field name="name">Subscription Licenses</field>
        <field name="res_model">subscription.license</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items -->
    <menuitem id="subscription_license_menu"
              name="Subscription Licenses"
              parent="menu_pos_integration_root"
              action="subscription_license_action"
              sequence="40"/>
</odoo>
