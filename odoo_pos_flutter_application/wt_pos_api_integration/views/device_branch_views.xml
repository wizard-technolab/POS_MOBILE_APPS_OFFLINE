<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="device_branch_view_list" model="ir.ui.view">
        <field name="name">device.branch.list</field>
        <field name="model">device.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="device_branch_view_form" model="ir.ui.view">
        <field name="name">device.branch.form</field>
        <field name="model">device.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="device_code"/>
                                    <field name="status"/>
                                    <field name="last_seen"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">device.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_integration_root"
              name="POS Integration"
              sequence="10"/>

    <menuitem id="device_branch_menu"
              name="Branches"
              parent="menu_pos_integration_root"
              action="device_branch_action"
              sequence="10"/>
</odoo>
