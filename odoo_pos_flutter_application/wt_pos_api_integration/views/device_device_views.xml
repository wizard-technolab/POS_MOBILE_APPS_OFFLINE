<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="device_device_view_list" model="ir.ui.view">
        <field name="name">device.device.list</field>
        <field name="model">device.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_code"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'inactive'"/>
                <field name="last_seen"/>
                <field name="branch_id"/>
            </list>
        </field>
    </record>

    <record id="device_device_view_form" model="ir.ui.view">
        <field name="name">device.device.form</field>
        <field name="model">device.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_code"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="last_seen" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">device.device</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="device_device_menu"
              name="Devices"
              parent="menu_pos_integration_root"
              action="device_device_action"
              sequence="20"/>
</odoo>
